# ── VaultRAG Environment ──────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# PostgreSQL
POSTGRES_USER=vaultrag
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vaultrag
DATABASE_URL=postgresql://vaultrag:changeme@localhost:5432/vaultrag

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=vaultrag_chunks
QDRANT_TEST_COLLECTION=vaultrag_test_chunks

# JWT – IMPORTANT: generate a long random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Ollama (running natively on the host, not in Docker)
OLLAMA_URL=http://localhost:11434

# CORS – comma-separated origins allowed to call the API.
# Defaults shown below. Never use "*" or "null".
# If you serve the frontend with python -m http.server 8080, use http://127.0.0.1:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Embedding models (Step 2)
EMBED_MODEL=BAAI/bge-m3
SPARSE_MODEL=Qdrant/bm25

# Dataset directory (relative to repository root)
DATASET_DIR=data/northwind/rag_demo_dataset

# Step 3: Registration & Reranking settings
ALLOW_SELF_REGISTER=false
RERANK_ENABLED=false
RERANK_CANDIDATES=20
RERANK_MODEL=BAAI/bge-reranker-v2-m3
SEARCH_RATE_LIMIT_PER_MINUTE=60

# Seed users demo password (demo-only, never use in production)
SEED_PASSWORD=changeme123

# Step 5: LLM & Grounded Answer Pipeline
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_FALLBACK_MODEL=qwen2.5:3b
LLM_TIMEOUT_S=90
LLM_MAX_TOKENS=400
# SECURITY WARNING: Setting LLM_FALLBACK_ENABLED=true with hosted providers (Groq, Gemini)
# sends confidential document text outside your local machine to third-party cloud APIs.
# Kept FALSE by default for strict data sovereignty.
LLM_FALLBACK_ENABLED=false
ASK_TOP_K=5
ASK_CANDIDATES=10
ASK_USE_RERANK=true
RELEVANCE_THRESHOLD=0.05
SUPPORT_THRESHOLD=0.05
VERIFY_WITH_LLM=false
ASK_RATE_LIMIT_PER_MINUTE=20

# Admin Access
# When true, role:admin is added to the ACL of every chunk so the platform admin can read all documents. All admin reads are audited.
ADMIN_SEES_ALL=true
 
# Step 4b: OCR & Image Ingestion
OCR_ENGINE=rapidocr
OCR_MIN_CONFIDENCE=0.5

# Step 5e: Department Access Model
# Choose 'department' (default) for department-based ACLs with salary rule,
# or 'dataset' to reproduce evaluation on original dataset role-based model.
ACCESS_MODEL=department
# When true (default), company policies are readable by all active users (org:northwind).
# When false, company policies become restricted to HR (dept:HR).
POLICIES_COMPANY_WIDE=true
DEMO_VISIBLE_USERS=admin@northwind.example,meera.iyer@northwind.example,karan.shah@northwind.example,asha.patel@northwind.example,u_admin,u_meera,u_karan,u_asha
